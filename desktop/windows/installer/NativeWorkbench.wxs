<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <!-- Only read-only native safety gates; no application launch, network bootstrap, credentials or data-directory resources. -->
  <Package Name="Haoduoyu Native Workbench" Manufacturer="Haoduoyu"
           Version="$(var.ProductVersion)" Language="1033" Scope="perUser"
           ProductCode="$(var.ProductCode)" UpgradeCode="E13CC61A-A22B-4C8A-A8D2-8EAB92679C50"
           InstallerVersion="500" Compressed="yes">
    <Binary Id="InstallerGuard" SourceFile="$(var.GuardDll)" />
    <CustomAction Id="HdyValidateInstallOwnership" BinaryRef="InstallerGuard" DllEntry="ValidateInstallOwnership" Return="check" />
    <CustomAction Id="HdyGuardBeforeRemove" BinaryRef="InstallerGuard" DllEntry="VerifyTransactionPaths" Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="HdyGuardBeforeInstall" BinaryRef="InstallerGuard" DllEntry="VerifyTransactionPaths" Execute="deferred" Impersonate="yes" Return="check" />
    <InstallUISequence>
      <Custom Action="HdyValidateInstallOwnership" After="CostFinalize" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="HdyValidateInstallOwnership" After="CostFinalize" />
      <Custom Action="HdyGuardBeforeRemove" Before="RemoveShortcuts" />
      <Custom Action="HdyGuardBeforeInstall" Before="InstallFiles" Condition="NOT (REMOVE ~= &quot;ALL&quot;)" />
    </InstallExecuteSequence>
    <SummaryInformation Description="Unsigned per-user native workbench installation candidate" />
    <MediaTemplate EmbedCab="yes" />
    <MajorUpgrade DowngradeErrorMessage="A newer Native Workbench is installed. Close it and use the newer package."
                  AllowSameVersionUpgrades="no" Schedule="afterInstallInitialize" />
    <!-- MSI compares only the first three version fields. A different source at the same version must not coexist. -->
    <Upgrade Id="E13CC61A-A22B-4C8A-A8D2-8EAB92679C50">
      <UpgradeVersion Minimum="$(var.ProductVersion)" Maximum="$(var.ProductVersion)"
                      IncludeMinimum="yes" IncludeMaximum="yes" OnlyDetect="yes"
                      Property="HDY_SAME_VERSION" />
    </Upgrade>
    <Launch Condition="Installed OR NOT HDY_SAME_VERSION"
            Message="This version is already installed from another source. Use a newer version, or explicitly uninstall first. Your workbench data is retained." />
    <Launch Condition="NOT ALLUSERS" Message="This package only supports installation for the current user." />
    <Launch Condition="VersionNT64" Message="This package requires 64-bit Windows." />
    <!-- Never ask Restart Manager to close an editor or restart the machine. Close the app yourself before maintenance. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <Property Id="REBOOT" Value="ReallySuppress" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPCOMMENTS" Value="Unsigned native candidate. User data is separate and is retained on uninstall. Close the workbench before maintenance." />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="HdyProgramsFolder" Name="Programs">
        <Directory Id="HdyVendorProgramsFolder" Name="Haoduoyu">
          <Directory Id="HdyInstallFolder" Name="NativeWorkbench" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <!-- Private directory id: no public INSTALLFOLDER property or install-location UI. -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="HdyStartMenuFolder" Name="Haoduoyu Native Workbench">
        <Component Id="StartMenuShortcut" Guid="617A2153-7208-43D1-BB6A-22F178455893" Bitness="always64">
          <Shortcut Id="LaunchNativeWorkbench" Name="Haoduoyu Native Workbench"
                    Target="[HdyInstallFolder]Haoduoyu.Workbench.exe" WorkingDirectory="HdyInstallFolder" />
          <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\Haoduoyu\NativeWorkbench\Installer" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <Feature Id="NativeWorkbench" Title="Native Workbench" Level="1">
      <ComponentGroupRef Id="PublishPayload" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>
</Wix>
