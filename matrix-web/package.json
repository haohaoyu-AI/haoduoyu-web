{
  "name": "haoduoyu-matrix",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=24.0.0"},
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "admin": "node scripts/admin.mjs",
